{
  "name": "@tengu/memory-server",
  "version": "0.1.0",
  "description": "MCP server providing evidence-linked memory graph with typed nodes, freshness decay, and contradiction handling",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tengu-memory": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "pnpm --filter @tengu/shared-types run build && tsup",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/integration-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:ship": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "sql.js": "^1.12.0",
    "zod": "^3.24.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tengu/shared-types": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
