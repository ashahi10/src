{
  "name": "@tengu/risk-server",
  "version": "0.1.0",
  "description": "MCP server providing centralized risk scoring (R1/R2/R3) with auditable approval modes and policy versioning",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tengu-risk": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "sql.js": "^1.12.0",
    "zod": "^3.24.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tengu/shared-types": "workspace:*",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
