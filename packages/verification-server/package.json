{
  "name": "@mnemai/verification-server",
  "version": "0.1.0",
  "description": "MCP server for durable verification proofs (sql.js SQLite)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mnemai-verification": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/integration-smoke.ts",
    "test": "vitest run",
    "verify:ship": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "sql.js": "^1.12.0",
    "zod": "^3.24.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
